[alias]
  llma = ! git-llm-annotate "$@"
  llmc = ! git-llm-annotate --commit "$@"
[llm-annotate]
  trailer-name = "LLM-Annotate"
  ; trailer-name = "LLM-Annotate-Provenance"
  ; allowed-traits = "LLM-Generated,LLM-Guided,LLM-Vibecoded,LLM-Reviewed,Human-Author-Skimmed,Human-Author-Reviewed,Human-Reviewer-Approved"
